# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Create a free cluster at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prem-portfolio

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_admin_token

# The ONLY admin account is created by the seed script from these values.
# There is no public registration endpoint.
ADMIN_NAME=Prem Rajpal Biradar
ADMIN_EMAIL=premrb2001@gmail.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ---- Cloudinary (image & resume storage) ----
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Outbound email (contact form) ----
# Option A: SMTP (e.g. Gmail app password, Zoho, SendGrid SMTP, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Option B: Resend (used instead of SMTP if RESEND_API_KEY is set)
RESEND_API_KEY=

CONTACT_EMAIL=premrb2001@gmail.com
